{
  "description": "stats-bar 薄壳自检：会话启动时按 asar 头部索引毫秒级检测补丁哨兵。缺失时只落 pending 交由登录自愈任务/手动提权处理，会话内绝不写 asar（Program Files 需管理员）。",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "python",
            "args": [
              "${ZCODE_PLUGIN_ROOT}/patch/ensure_patch.py",
              "--session-check"
            ],
            "timeoutMs": 20000,
            "statusMessage": "stats-bar 薄壳自检…"
          }
        ]
      }
    ]
  }
}
